            "mimeType": "application/json",
            "text": "{\"operationName\":\"PreviewTransactionRule\",\"variables\":{\"rule\":{\"merchantCriteriaUseOriginalStatement\":false,\"merchantCriteria\":[{\"operator\":\"contains\",\"value\":\"numberbarn\"}],\"setCategoryAction\":\"220719326595030610\",\"applyToExistingTransactions\":true}},\"query\":\"query PreviewTransactionRule($rule: TransactionRulePreviewInput!, $offset: Int) {\\n  transactionRulePreview(input: $rule) {\\n    totalCount\\n    results(offset: $offset, limit: 30) {\\n      newName\\n      newSplitTransactions\\n      newCategory {\\n        id\\n        icon\\n        name\\n        __typename\\n      }\\n      newHideFromReports\\n      newTags {\\n        id\\n        name\\n        color\\n        order\\n        __typename\\n      }\\n      newGoal {\\n        id\\n        name\\n        imageStorageProvider\\n        imageStorageProviderId\\n        __typename\\n      }\\n      newSplitTransactions\\n      transaction {\\n        id\\n        date\\n        amount\\n        merchant {\\n          id\\n          name\\n          __typename\\n        }\\n        category {\\n          id\\n          name\\n          icon\\n          __typename\\n        }\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n}\"}"
